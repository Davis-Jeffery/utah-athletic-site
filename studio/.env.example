# Copy to .env and fill in. The project ID comes from `sanity projects create`.
SANITY_STUDIO_PROJECT_ID=03wnsd9x
SANITY_STUDIO_DATASET=production
# Where the Presentation tool loads the site from (Phase 2). Leave as is for now.
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321

# Optional: Google Places for the Studio's place search (venues, tournaments, map pins). Without it the
# search uses OpenStreetMap. In Google Cloud: enable "Maps JavaScript API" and "Places API (New)", create
# an API key, restrict it to websites https://utah-athletic.sanity.studio/* and http://localhost:3333/*
# and to those two APIs. The key ends up in the Studio's code, which is why it must be restricted.
SANITY_STUDIO_GOOGLE_MAPS_KEY=
