# Copy to .env (never commit .env).
# Required for builds: Sanity hides program and region documents (ids with a dot) from anonymous
# reads. Create a Viewer token at sanity.io/manage > project > API > Tokens, and add the same
# variable in Vercel > Settings > Environment Variables (Production and Preview).
SANITY_READ_TOKEN=

# ---------- Forms and Futures payments (server routes in src/pages/api/) ----------
# Add each in Vercel too. Without the optional ones the feature they power is simply off.
# Editor token (sanity.io/manage > API > Tokens): saves Submissions and Futures registrations.
SANITY_WRITE_TOKEN=
# Stripe (dashboard > Developers > API keys). Use test keys (sk_test_...) until launch.
STRIPE_SECRET_KEY=
# From the webhook endpoint for https://<site>/api/stripe/webhook/ (Developers > Webhooks), or
# from `stripe listen --forward-to localhost:4321/api/stripe/webhook/` when testing locally.
STRIPE_WEBHOOK_SECRET=
# Optional: emails through Resend (resend.com). EMAIL_FROM must use a domain verified there,
# e.g. "Utah Athletic <hello@mail.utathletic-club.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Optional: Cloudflare Turnstile spam check (dash.cloudflare.com > Turnstile). Both or neither.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
