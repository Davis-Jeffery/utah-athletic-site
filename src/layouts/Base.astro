---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { loadSite } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /** Link-preview image (1200 x 630). Defaults to Site settings' share image. */
  image?: string;
  /** Keep this page out of search results (e.g. the payment thank-you page). */
  noindex?: boolean;
  /** Extra schema.org structured data for this page, besides the organization on every page. */
  jsonLd?: Record<string, unknown>[];
  preload?: string;
  bodyClass?: string;
}
const data = await loadSite();
const {
  title,
  description = 'Utah Athletic Soccer Club: Academy, Club, Recreation and Futures programs for Utah players.',
  image = data.seo.shareDefault,
  noindex = false,
  jsonLd = [],
  preload,
  bodyClass,
} = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
// The club itself, on every page: name, logo, contact and social profiles (schema.org).
const organization = {
  '@context': 'https://schema.org', '@type': 'SportsOrganization', '@id': new URL('/#organization', site).href,
  name: 'Utah Athletic', alternateName: 'Utah Athletic Soccer Club', sport: 'Soccer', url: site.href,
  logo: 'https://cdn.sanity.io/images/03wnsd9x/production/7136068a606a4a8c18b238e508f4eda1a27b6a96-166x77.png',
  email: data.settings.mainEmail, areaServed: { '@type': 'State', name: 'Utah' },
  sameAs: data.settings.social.map((s) => s.href),
};
const structured = [organization, ...jsonLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#111318" />
    <Analytics />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Utah Athletic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" href={preload} as="image" />}
    {structured.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
  </head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      // The header's Tryouts button opens on the visitor's remembered region.
      (function () {
        var r = (document.cookie.match(/(?:^|; )ua_region=(north|south|west)/) || [])[1];
        if (!r) return;
        document.querySelectorAll('a[data-tryouts-link]').forEach(function (a) {
          // Links inside React islands update themselves after hydration.
          if (!a.closest('astro-island') && a.getAttribute('href') === '/tryouts/') a.setAttribute('href', '/tryouts/?region=' + r);
        });
      })();
      // Hamburger menu (SiteHeader): close it on a link click, Escape or a tap outside.
      (function () {
        var shut = function () { document.querySelectorAll('details.site-menu[open]').forEach(function (d) { d.open = false; }); };
        document.addEventListener('click', function (e) {
          var open = document.querySelector('details.site-menu[open]');
          if (!open) return;
          if (e.target.closest('.site-menu a') || !e.target.closest('details.site-menu')) shut();
        });
        // Capture phase, so Escape closes the menu and not the program page underneath.
        window.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && document.querySelector('details.site-menu[open]')) { e.preventDefault(); e.stopPropagation(); shut(); }
        }, true);
      })();
    </script>
  </body>
</html>
