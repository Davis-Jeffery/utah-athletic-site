---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { loadSite } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /** Link-preview image (1200 x 630). Defaults to Site settings' share image. */
  image?: string;
  /** Keep this page out of search results (e.g. the payment thank-you page). */
  noindex?: boolean;
  /** Extra schema.org structured data for this page, besides the organization on every page. */
  jsonLd?: Record<string, unknown>[];
  preload?: string;
  bodyClass?: string;
}
const data = await loadSite();
const {
  title,
  description = 'Utah Athletic Soccer Club: Academy, Club, Recreation and Futures programs for Utah players.',
  image = data.seo.shareDefault,
  noindex = false,
  jsonLd = [],
  preload,
  bodyClass,
} = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
// The club itself, on every page: name, logo, contact and social profiles (schema.org).
const organization = {
  '@context': 'https://schema.org', '@type': 'SportsOrganization', '@id': new URL('/#organization', site).href,
  name: 'Utah Athletic', alternateName: 'Utah Athletic Soccer Club', sport: 'Soccer', url: site.href,
  logo: data.brand.logoPng,
  email: data.settings.mainEmail, areaServed: { '@type': 'State', name: 'Utah' },
  sameAs: data.settings.social.map((s) => s.href),
};
const structured = [organization, ...jsonLd];
const mk = data.marketing;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#111318" />
    <Analytics />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Utah Athletic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {/* Icons: from Site settings > Logo and icon when set, else the files in public/. */}
    <link rel="icon" href={data.brand.icons?.icon32 ?? '/favicon-32.png'} type="image/png" sizes="32x32" />
    <link rel="icon" href={data.brand.icons?.icon192 ?? '/icon-192.png'} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={data.brand.icons?.apple ?? '/apple-touch-icon.png'} />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" href={preload} as="image" />}
    {structured.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
    {/* Marketing tracking (Site settings > Marketing): each tool loads only once its ID is set. */}
    {mk?.gtm && <script is:inline define:vars={{ id: mk.gtm }}>
      (function (w, d, l) { w[l] = w[l] || []; w[l].push({ 'gtm.start': Date.now(), event: 'gtm.js' }); var s = d.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtm.js?id=' + id; d.head.appendChild(s); })(window, document, 'dataLayer');
    </script>}
    {(mk?.ga4 || mk?.ads) && <script async src={`https://www.googletagmanager.com/gtag/js?id=${mk.ga4 || mk.ads}`}></script>}
    {(mk?.ga4 || mk?.ads) && <script is:inline define:vars={{ ga4: mk.ga4, ads: mk.ads }}>
      window.dataLayer = window.dataLayer || []; window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date()); if (ga4) gtag('config', ga4); if (ads) gtag('config', ads);
    </script>}
    {mk?.pixel && <script is:inline define:vars={{ id: mk.pixel }}>
      !function (f, b, e, v, n, t, s) { if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); }; if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = []; t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s); }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', id); fbq('track', 'PageView');
    </script>}
    {mk && <script is:inline define:vars={{ cfg: { ads: mk.ads, labels: mk.labels, hosts: mk.registerHosts, gtm: !!mk.gtm } }}>
      // window.uaTrack(kind, { value, id }): reports a site action to every tool that's on.
      // Kinds: purchase (Futures paid), lead_trial, lead_interest, contact, ollie (Register click to Ollie).
      (function () {
        var GA = { purchase: 'purchase', lead_trial: 'generate_lead', lead_interest: 'generate_lead', contact: 'generate_lead', ollie: 'begin_checkout' };
        var META = { purchase: 'Purchase', lead_trial: 'Lead', lead_interest: 'Lead', contact: 'Contact', ollie: 'InitiateCheckout' };
        var ADS = { purchase: 'futures', lead_trial: 'trial', lead_interest: 'interest', contact: 'contact', ollie: 'ollie' };
        window.uaTrack = function (kind, d) {
          d = d || {};
          var money = d.value != null ? { value: d.value, currency: 'USD' } : {};
          try {
            if (window.gtag) {
              window.gtag('event', GA[kind], Object.assign({ event_category: kind }, money, d.id ? { transaction_id: d.id } : {}));
              var label = cfg.ads && cfg.labels[ADS[kind]];
              if (label) window.gtag('event', 'conversion', Object.assign({ send_to: cfg.ads + '/' + label }, money, d.id ? { transaction_id: d.id } : {}));
            }
            if (window.fbq) window.fbq('track', META[kind], money, d.id ? { eventID: d.id } : undefined);
            if (cfg.gtm) (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: 'ua_' + kind }, money, d.id ? { transaction_id: d.id } : {}));
          } catch (e) { /* tracking never breaks the page */ }
        };
        // Register clicks that leave for Ollie (or any outside registration link in the content).
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          try { if (cfg.hosts.indexOf(new URL(a.href).hostname) !== -1) window.uaTrack('ollie'); } catch (err) { /* not a URL */ }
        }, true);
      })();
    </script>}
  </head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      // The header's Tryouts button opens on the visitor's remembered region.
      (function () {
        var r = (document.cookie.match(/(?:^|; )ua_region=(north|south|west)/) || [])[1];
        if (!r) return;
        document.querySelectorAll('a[data-tryouts-link]').forEach(function (a) {
          // Links inside React islands update themselves after hydration.
          if (!a.closest('astro-island') && a.getAttribute('href') === '/tryouts/') a.setAttribute('href', '/tryouts/?region=' + r);
        });
      })();
      // Directions links (studio/shared/places.ts) point at Google Maps; on iPhones, iPads and Macs a
      // click opens Apple Maps instead, with the same destination.
      (function () {
        var apple = /iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent);
        if (!apple) return;
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="https://www.google.com/maps/dir/"]');
          if (!a) return;
          var u = new URL(a.href), to = u.searchParams.get('destination') || '';
          var q = new URLSearchParams({ daddr: to });
          if (/^-?[\d.]+,-?[\d.]+$/.test(to)) q.set('q', (a.textContent || '').trim());
          a.href = 'https://maps.apple.com/?' + q.toString();
        }, true);
      })();
      // Hamburger menu (SiteHeader): close it on a link click, Escape or a tap outside.
      (function () {
        var shut = function () { document.querySelectorAll('details.site-menu[open]').forEach(function (d) { d.open = false; }); };
        document.addEventListener('click', function (e) {
          var open = document.querySelector('details.site-menu[open]');
          if (!open) return;
          if (e.target.closest('.site-menu a') || !e.target.closest('details.site-menu')) shut();
        });
        // Capture phase, so Escape closes the menu and not the program page underneath.
        window.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && document.querySelector('details.site-menu[open]')) { e.preventDefault(); e.stopPropagation(); shut(); }
        }, true);
      })();
    </script>
  </body>
</html>
