---
import '../styles/global.css';
import { ORDER, PROGRAMS } from '../data/programs';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Utah Athletic Soccer Club: Academy, Club, Recreation and Futures programs for Utah players.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo-ua.avif" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo"><img src="/logo-ua.avif" alt="Utah Athletic" height="40" /></a>
      <nav>
        {ORDER.map((k) => <a href={`/programs/${k}/`}>{PROGRAMS[k].name}</a>)}
      </nav>
      <a class="btn" href="/programs/club/#join">Tryouts 2026 →</a>
    </header>
    <div class="hr"></div>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="hr"></div>
        <p class="muted">© {new Date().getFullYear()} Utah Athletic Soccer Club</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
    padding: 14px var(--gutter);
    background: rgba(17, 19, 24, 0.8); backdrop-filter: blur(14px);
  }
  .logo { margin-right: auto; }
  .logo img { height: 40px; width: auto; }
  nav { display: flex; gap: 22px; font-size: 14px; flex-wrap: wrap; }
  nav a { color: var(--color-neutral-400); }
  nav a:hover { color: var(--color-text); }
  .site-footer { padding: 48px 0 32px; }
  .site-footer p { margin-top: 24px; font-size: 13px; }
  @media (max-width: 640px) {
    .site-header { gap: 12px; }
    nav { order: 3; width: 100%; gap: 16px; }
    .btn { padding: 9px 12px; font-size: 13px; }
  }
</style>
