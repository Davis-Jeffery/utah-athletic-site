---
// The Athletic Global network. Reached from the pyramid's Professional tier, which zooms in;
// this page zooms in on arrival to finish the move. Copy and imagery are placeholders until
// Athletic Global supplies them.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.jsx';
import SiteFooter from '../components/SiteFooter.jsx';
import NetworkMap from '../components/NetworkMap.jsx';
import { Placeholder } from '../components/ui.jsx';
import { loadSite } from '../lib/content';
import { buildAssets } from '../lib/assets';
import { NETWORK_AFFILIATE_SLOTS } from '../data/site';

const data = await loadSite();
const A = await buildAssets();
const kicker = 'font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--color-accent)';
const h2 = 'margin:0;font:500 clamp(38px,4.4vw,64px)/1 var(--font-heading);letter-spacing:-.04em';
const means = [
  ['Training exchanges', 'Selected Academy players train inside a professional environment with network clubs, and network staff visit Utah.'],
  ['A pathway to the pro game', 'A defined route from Utah Athletic Academy to a professional club in the same family. RC Vichy Athletic is the first.'],
  ['Shared methodology', 'One game model, one coaching curriculum and one player-development standard across every club in the network.'],
];
const facts = [['City', 'Vichy, Auvergne-Rhône-Alpes'], ['Status', 'Partnership · active'], ['Role in network', 'Professional club'], ['League', 'To be supplied']];
---
<Base title="Athletic Global network | Utah Athletic" description="Utah Athletic is part of Athletic Global, a network of affiliate academies and professional clubs with a route to the professional game." bodyClass="page-zoom-in">
  <div style="position:relative;overflow-x:clip;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body)">
    <SiteHeader current="network" logo={data.logo} tryoutsLabel={data.settings.tryoutsLabel} />

    <section style="position:relative;min-height:min(78vh,720px);display:flex;align-items:flex-end;overflow:hidden">
      <img src={A['collage-c19@lg']} alt="" fetchpriority="high" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;filter:grayscale(1) contrast(1.15) brightness(.6)" />
      <div style="position:absolute;inset:0;background:#78b7b3;mix-blend-mode:color;opacity:.45;pointer-events:none"></div>
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(17,19,24,.5) 0%,rgba(17,19,24,.2) 35%,#111318 100%),radial-gradient(ellipse at 15% 100%,rgba(120,183,179,.18),transparent 55%);pointer-events:none"></div>
      <div style="position:relative;width:100%;max-width:1360px;margin:0 auto;padding:96px clamp(20px,4vw,56px) 64px;display:flex;flex-direction:column;gap:22px">
        <a href="/#programs" class="hv-outline" style="align-self:flex-start;display:flex;align-items:center;gap:10px;min-height:40px;font-size:13px;color:var(--color-neutral-300);border:1px solid var(--color-divider);padding:0 12px;border-radius:8px;background:rgba(17,19,24,.6);backdrop-filter:blur(8px)">← The pathway</a>
        <div style="display:flex;align-items:center;gap:12px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--color-accent)"><span style="width:28px;height:1px;background:var(--color-accent)"></span>Athletic Global</div>
        <h1 style="margin:0;max-width:980px;font:500 clamp(48px,6.6vw,104px)/.95 var(--font-heading);letter-spacing:-.045em;text-wrap:balance">One network. <span style="color:#78b7b3">A route to the professional game.</span></h1>
        <p style="margin:0;max-width:600px;font-size:17px;line-height:1.6;color:var(--color-neutral-300);text-wrap:pretty">Athletic Global is building a network of affiliate academies and professional clubs that share one methodology. Utah Athletic is part of it today, alongside RC Vichy Athletic in France. More academies are in development.</p>
        <Placeholder>Placeholder · vision copy to be supplied</Placeholder>
      </div>
    </section>

    <main style="max-width:1360px;margin:0 auto;padding:0 clamp(20px,4vw,56px)">
      <section style="padding:72px 0 64px;display:flex;flex-direction:column;gap:32px">
        <div style="display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap">
          <div style="display:flex;flex-direction:column;gap:16px"><span style={kicker}>01 · The network</span><h2 style={h2}>What exists, and what's being built</h2></div>
          <div style="display:flex;gap:18px;font-size:12px;color:var(--color-neutral-400)">
            <span style="display:flex;align-items:center;gap:8px"><span style="width:14px;height:14px;border-radius:4px;background:rgba(120,183,179,.18);box-shadow:0 0 0 1px #78b7b3"></span>Today</span>
            <span style="display:flex;align-items:center;gap:8px"><span style="width:14px;height:14px;border-radius:4px;border:1px dashed var(--color-neutral-500)"></span>In development</span>
          </div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:stretch">
          <div style="flex:2 1 560px;min-width:0;display:flex;flex-direction:column;padding:12px;border-radius:14px;background:linear-gradient(160deg,#171920,#0d0f13);box-shadow:inset 0 0 0 1px var(--color-divider),0 24px 60px rgba(0,0,0,.45)">
            <NetworkMap client:visible />
          </div>
          <div style="flex:1 1 280px;min-width:0;display:flex;flex-direction:column;gap:8px">
            {[['Today · Academy', 'Utah Athletic', 'Utah, USA · Futures through Academy'], ['Today · Professional', 'RC Vichy Athletic', 'Vichy, France · Partnership']].map(([k, name, sub]) => (
              <div style="display:flex;flex-direction:column;gap:6px;padding:16px 18px;border-radius:10px;background:linear-gradient(120deg,rgba(120,183,179,.12),transparent 70%),var(--color-surface);box-shadow:0 0 0 1px var(--color-accent-800)">
                <span style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--color-accent)">{k}</span>
                <span style="font:500 21px/1.1 var(--font-heading);letter-spacing:-.03em">{name}</span>
                <span style="font-size:13px;color:var(--color-neutral-400)">{sub}</span>
              </div>
            ))}
            {Array.from({ length: NETWORK_AFFILIATE_SLOTS }, (_, i) => (
              <div style="display:flex;flex-direction:column;gap:6px;padding:16px 18px;border-radius:10px;border:1px dashed var(--color-neutral-600)">
                <span style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--color-neutral-500)">In development</span>
                <span style="font:500 18px/1.1 var(--font-heading);letter-spacing:-.02em;color:var(--color-neutral-300)">Affiliate academy {String(i + 1).padStart(2, '0')}</span>
                <span style="font-size:13px;color:var(--color-neutral-500)">Location to be announced</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section style="padding:64px 0;display:flex;flex-direction:column;gap:32px">
        <div style="display:flex;flex-direction:column;gap:16px"><span style={kicker}>02 · For a Utah player</span><h2 style={h2}>What the network means</h2></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:12px">
          {means.map(([t, d], i) => (
            <div style="display:flex;flex-direction:column;gap:14px;padding:24px;border-radius:10px;background:var(--color-surface);box-shadow:var(--shadow-sm)">
              <span style="font:500 13px/1 var(--font-heading);color:var(--color-accent)">0{i + 1}</span>
              <h3 style="margin:0;font:500 24px/1.1 var(--font-heading);letter-spacing:-.03em">{t}</h3>
              <p style="margin:0;font-size:14px;line-height:1.6;color:var(--color-neutral-400);text-wrap:pretty">{d}</p>
            </div>
          ))}
        </div>
        <Placeholder>Placeholder · details to be confirmed</Placeholder>
      </section>

      <section style="padding:64px 0;display:flex;flex-direction:column;gap:32px">
        <div style="display:flex;flex-direction:column;gap:16px"><span style={kicker}>03 · Professional club</span><h2 style={h2}>RC Vichy Athletic</h2></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:12px">
          <div style="display:flex;flex-direction:column;gap:24px;padding:clamp(24px,3vw,36px);border-radius:12px;background:radial-gradient(ellipse at 0% 0%,rgba(120,183,179,.14),transparent 60%),var(--color-surface);box-shadow:var(--shadow-md)">
            <div style="display:flex;align-items:center;gap:20px">
              <span style="width:104px;height:104px;flex:none;border-radius:50%;border:1px dashed var(--color-neutral-600);display:flex;align-items:center;justify-content:center;text-align:center;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--color-neutral-500)">RC Vichy<br />crest</span>
              <div style="display:flex;flex-direction:column;gap:6px">
                <span style="font:500 28px/1.05 var(--font-heading);letter-spacing:-.03em">RC Vichy Athletic</span>
                <span style="font-size:14px;color:var(--color-neutral-400)">Vichy, France</span>
              </div>
            </div>
            <dl style="margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;border-radius:10px;overflow:hidden;background:var(--color-divider)">
              {facts.map(([k, v]) => (
                <div style="display:flex;flex-direction:column;gap:6px;padding:14px 16px;background:var(--color-bg)">
                  <dt style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--color-neutral-500)">{k}</dt>
                  <dd style={`margin:0;display:flex;align-items:center;gap:8px;font:500 17px/1.2 var(--font-heading);color:${k === 'League' ? 'var(--color-neutral-400)' : 'inherit'}`}>
                    {k === 'Status' && <span style="width:8px;height:8px;flex:none;border-radius:50%;background:#78b7b3;box-shadow:0 0 8px #78b7b3"></span>}{v}
                  </dd>
                </div>
              ))}
            </dl>
            <p style="margin:0;font-size:15px;line-height:1.65;color:var(--color-neutral-300);text-wrap:pretty">RC Vichy Athletic is the first professional club in the Athletic Global network. Club description, history and first-team details will be supplied by Athletic Global.</p>
            <Placeholder>Placeholder · crest and description to be supplied</Placeholder>
          </div>
          <div style="position:relative;min-height:360px;border-radius:12px;overflow:hidden;background:repeating-linear-gradient(135deg,#1a1d23 0 12px,#1f2229 12px 24px);display:flex;align-items:flex-end;padding:16px;font:500 10px/1 ui-monospace,Menlo,monospace;color:var(--color-neutral-600);text-transform:uppercase">RC Vichy Athletic photography</div>
        </div>
      </section>

      <section style="padding:48px 0 104px">
        <div style="display:flex;flex-direction:column;gap:20px;padding:clamp(32px,5vw,64px);border-radius:14px;background:radial-gradient(ellipse at 0% 0%,rgba(120,183,179,.18),transparent 60%),var(--color-surface);box-shadow:var(--shadow-md)">
          <span style={kicker}>The pathway starts in Utah</span>
          <h2 style="margin:0;max-width:820px;font:500 clamp(36px,5vw,72px)/.98 var(--font-heading);letter-spacing:-.045em;text-wrap:balance">Every route into the network begins at one of four levels.</h2>
          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <a href="/#programs" class="hv-t10" style="display:flex;align-items:center;min-height:48px;border:1px solid var(--color-accent);color:var(--color-accent);font:500 15px/1 var(--font-body);padding:0 20px;border-radius:8px">See the pathway →</a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter social={data.settings.social} />
  </div>
</Base>
