---
// /events/<slug>/rules/: a hosted tournament's rules and format (Studio: the event's Rules tab),
// one block per topic with a jump list, the PDF when there is one, and a way to ask the directors.
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.jsx';
import SiteFooter from '../../../components/SiteFooter.jsx';
import { loadEventPages, loadSite } from '../../../lib/content';

export async function getStaticPaths() {
  return (await loadEventPages()).filter((ev) => ev.rules.length).map((ev) => ({ params: { slug: ev.slug }, props: { ev } }));
}

const { ev } = Astro.props;
const data = await loadSite();
const page = `/events/${ev.slug}/`;
const logo = ev.hero.logo || ev.logo;
const btn = 'display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 20px;border-radius:10px;border:1px solid var(--ev-accent);font:600 15px/1 var(--font-body)';
---
<Base title={`${ev.name} Rules and Format | Utah Athletic`} description={ev.rulesIntro || `Rules, format and match play for ${ev.name}.`} image={ev.seo.image}>
  <div style={`position:relative;min-height:100vh;overflow-x:clip;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body);--ev-bg:${ev.brand.bg};--ev-bg2:${ev.brand.bg2};--ev-ink:${ev.brand.ink};--ev-accent:${ev.brand.accent}`}>
    <SiteHeader current="events" logo={data.logo} tryoutsLabel={data.settings.tryoutsLabel} />
    <header style="background:radial-gradient(ellipse at 30% 20%,var(--ev-bg2),var(--ev-bg) 70%)">
      <div style="max-width:1100px;margin:0 auto;padding:120px clamp(20px,4vw,56px) 48px;display:flex;flex-direction:column;gap:16px;color:var(--ev-ink)">
        <a href={page} class="hv-link" style="align-self:flex-start;display:flex;align-items:center;gap:16px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--ev-accent)">
          {logo ? <img src={logo.src} alt={logo.alt || `${ev.name} logo`} style="width:auto;max-width:60vw;height:clamp(72px,8vw,110px);object-fit:contain;filter:drop-shadow(0 8px 24px rgba(0,0,0,.45))" /> : null}
          ← {ev.name}
        </a>
        <h1 style="margin:0;font:500 clamp(44px,7vw,96px)/.92 var(--font-heading);letter-spacing:-.05em;text-wrap:balance">Rules and <span style="color:var(--ev-accent)">format</span></h1>
        {ev.rulesIntro ? <p style="margin:0;max-width:640px;font-size:17px;line-height:1.6;opacity:.85">{ev.rulesIntro}</p> : null}
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:6px">
          {ev.rulesFile ? <a href={ev.rulesFile} target="_blank" rel="noopener" class="hv-ev-solid" style={`${btn};background:var(--ev-accent);color:var(--ev-bg)`}>Download the PDF</a> : null}
          <a href={`/contact/?event=${ev.id}`} class="hv-ev" style={`${btn};color:var(--ev-ink);background:rgba(17,19,24,.45)`}>Ask the directors →</a>
        </div>
      </div>
    </header>
    <main class="rules-grid" style="max-width:1100px;margin:0 auto;padding:40px clamp(20px,4vw,56px) 96px;display:grid;gap:32px 48px;align-items:start">
      <nav aria-label="Rule topics" class="rules-nav" style="display:flex;flex-direction:column;gap:2px;border-left:1px solid var(--color-divider)">
        {ev.rules.map((r, i) => <a href={`#rule-${i + 1}`} class="hv-link" style="padding:8px 14px;font-size:14px;color:var(--color-neutral-300)"><span style="color:var(--ev-accent);font-variant-numeric:tabular-nums;margin-right:8px">{String(i + 1).padStart(2, '0')}</span>{r.heading}</a>)}
      </nav>
      <div style="min-width:0;display:flex;flex-direction:column;gap:20px">
        {ev.rules.map((r, i) => (
          <section id={`rule-${i + 1}`} style="scroll-margin-top:90px;display:flex;flex-direction:column;gap:14px;padding:clamp(20px,2.6vw,30px);border-radius:12px;background:var(--color-surface);box-shadow:var(--shadow-sm)">
            <h2 style="margin:0;display:flex;align-items:baseline;gap:12px;font:500 clamp(24px,2.4vw,32px)/1.1 var(--font-heading);letter-spacing:-.03em"><span style="font-size:14px;color:var(--ev-accent);font-variant-numeric:tabular-nums">{String(i + 1).padStart(2, '0')}</span>{r.heading}</h2>
            <ul style="margin:0;padding:0 0 0 20px;display:flex;flex-direction:column;gap:10px;font-size:16px;line-height:1.6;color:var(--color-neutral-200)">
              {r.items.map((x) => <li style="white-space:pre-line;padding-left:4px">{x}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </main>
    <SiteFooter social={data.settings.social} />
  </div>
</Base>
<style>
  .rules-grid { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .rules-grid { grid-template-columns: 220px minmax(0, 1fr); } .rules-nav { position: sticky; top: 90px; } }
  li::marker { color: var(--ev-accent); }
</style>
