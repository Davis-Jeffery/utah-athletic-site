---
import Base from '../layouts/Base.astro';
import UAApp from '../components/app/UAApp.jsx';
import { loadSite } from '../lib/content';

const data = await loadSite();
---
<Base title={data.seo.home.title} description={data.seo.home.description} image={data.seo.home.image} jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Utah Athletic', url: Astro.site!.href, publisher: { '@id': new URL('/#organization', Astro.site).href } }]}>
  <UAApp client:load data={data} />
</Base>
