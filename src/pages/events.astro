---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SiteHeader from '../components/SiteHeader.jsx';
import SiteFooter from '../components/SiteFooter.jsx';
import EventsApp from '../components/EventsApp.jsx';
import { loadSite } from '../lib/content';
import { buildAssets } from '../lib/assets';
import { FlagBanner, Handshake } from '@phosphor-icons/react';

const data = await loadSite();
const A = await buildAssets();
const card = 'display:flex;flex-direction:column;gap:12px;padding:clamp(20px,3vw,32px);border-radius:14px';
const kicker = 'display:flex;align-items:center;gap:10px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--color-accent)';
const btn = 'align-self:flex-start;margin-top:4px;display:flex;align-items:center;min-height:44px;padding:0 18px;border-radius:8px;border:1px solid #78b7b3;color:#b5e1dd;font:500 14px/1 var(--font-body)';
---
<Base title="Tournaments & Events | Utah Athletic" description="Every Utah Athletic tournament in one place: Copa Athletic, Summer Night Lights, Pioneer Cup and Chaos Cup." preload={A['collage-c18@lg']}>
  <div style="position:relative;min-height:100vh;overflow-x:clip;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body)">
    <SiteHeader current="events" logo={data.logo} tryoutsLabel={data.settings.tryoutsLabel} />
    <PageHero kicker="Tournaments & Events" photo={A['collage-c18@lg']} position="center 45%" bottom="clamp(36px,5vw,56px)">
      <h1 style="margin:0;max-width:900px;font:500 clamp(44px,6.6vw,100px)/.92 var(--font-heading);letter-spacing:-.05em;text-wrap:balance">Where Utah <span style="color:#78b7b3">comes to play.</span></h1>
      <p style="margin:0;max-width:560px;font-size:clamp(15px,1.4vw,18px);line-height:1.6;color:var(--color-neutral-300);text-wrap:pretty">Every Utah Athletic tournament in one place. Each event runs its own site for schedules, rules and team registration.</p>
    </PageHero>
    <main style="max-width:1280px;margin:0 auto;padding:8px clamp(16px,4vw,56px) 48px;display:flex;flex-direction:column;gap:56px">
      <EventsApp client:load events={data.events} builtOn={data.builtOn} />

      <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:14px">
        <div style={`${card};background:radial-gradient(ellipse at 0% 0%,rgba(120,183,179,.14),transparent 60%),var(--color-surface);box-shadow:0 0 0 1px var(--color-accent-800)`}>
          <span style={kicker}><FlagBanner size={18} aria-hidden="true" />Bring your club</span>
          <h2 style="margin:0;font:500 clamp(24px,2.6vw,32px)/1.08 var(--font-heading);letter-spacing:-.03em">Visiting teams welcome at every event.</h2>
          <p style="margin:0;font-size:14px;line-height:1.6;color:var(--color-neutral-400);text-wrap:pretty">Clubs from across the Mountain West enter our tournaments. Tell us your age groups and we'll point you to the right event and hotel blocks.</p>
          <a href="/contact/" class="hv-t14" style={btn}>Enquire for your club →</a>
        </div>
        <div style={`${card};background:var(--color-surface);box-shadow:var(--shadow-sm)`}>
          <span style={kicker}><Handshake size={18} aria-hidden="true" />Sponsor an event</span>
          <h2 style="margin:0;font:500 clamp(24px,2.6vw,32px)/1.08 var(--font-heading);letter-spacing:-.03em">Put your brand in front of thousands of families.</h2>
          <p style="margin:0;font-size:14px;line-height:1.6;color:var(--color-neutral-400);text-wrap:pretty">Field naming, vendor booths and digital packages are available across all four tournaments.</p>
          <a href="/contact/" class="hv-t14" style={btn}>Request the sponsor deck →</a>
        </div>
      </section>

      <section style="display:flex;flex-direction:column;gap:16px" aria-labelledby="reel-title">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap">
          <div style="display:flex;flex-direction:column;gap:8px">
            <span style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--color-accent)">Highlights</span>
            <h2 id="reel-title" style="margin:0;font:500 clamp(28px,3.2vw,44px)/1 var(--font-heading);letter-spacing:-.04em">From the touchline</h2>
          </div>
          <span aria-hidden="true" style="font-size:13px;color:var(--color-neutral-500)">Scroll →</span>
        </div>
        <div tabindex="0" aria-label="Tournament photos" style="display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px">
          {data.settings.eventReel.map(({ photo, event, caption }) => (
            <figure style="flex:none;width:min(78vw,340px);aspect-ratio:4 / 5;position:relative;margin:0;border-radius:12px;overflow:hidden;scroll-snap-align:start;background:#15171d">
              <img src={photo} alt={`${event}: ${caption}`} loading="lazy" decoding="async" class="hv-zoom" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s" />
              <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(17,19,24,.9));pointer-events:none"></div>
              <figcaption style="position:absolute;left:14px;bottom:12px;display:flex;flex-direction:column;gap:3px;pointer-events:none;margin:0">
                <span style="font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#b5e1dd">{event}</span>
                <span style="font:500 15px/1.2 var(--font-heading);color:var(--color-text)">{caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    </main>
    <SiteFooter note="Event schedules and registration are hosted on each event's own site." />
  </div>
</Base>
