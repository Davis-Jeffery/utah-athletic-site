---
// Each program has a real URL (/programs/rec/ etc.) for sharing and search.
// It renders the same app with that program's page already open; closing it
// animates back to the pyramid without a page load.
import Base from '../../layouts/Base.astro';
import UAApp from '../../components/UAApp.jsx';
import { ORDER, PROGRAMS, type ProgramKey } from '../../data/programs';
import { buildAssets } from '../../lib/assets';

export function getStaticPaths() {
  return ORDER.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as ProgramKey;
const p = PROGRAMS[slug];
const assets = await buildAssets();
---
<Base title={`${p.name} | Utah Athletic`} description={p.tagline} preload={assets[p.img]}>
  <UAApp client:load assets={assets} initial={slug} />
</Base>
