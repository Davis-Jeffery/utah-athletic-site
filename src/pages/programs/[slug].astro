---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { MONTHS, ORDER, PROGRAMS, type ProgramKey } from '../../data/programs';
import { REC_DIVISIONS, REC_GAME_RULES, COMBINING_POLICY, FORMAT_INSPIRATION } from '../../data/rec-formats';
import { img } from '../../lib/images';

export function getStaticPaths() {
  return ORDER.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as ProgramKey;
const p = PROGRAMS[slug];
const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const isRec = slug === 'rec';
---
<Base title={`${p.name} | Utah Athletic`} description={p.tagline}>
  <section class="hero">
    <Image src={img(p.img)} alt="" class="hero-bg" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    <div class="hero-tint"></div>
    <div class="wrap hero-inner">
      <p class="kicker">{p.tier} · {p.ages}</p>
      <h1 class="name">{p.name}</h1>
      <p class="lead">{p.tagline}</p>
      <a class="btn btn-solid" href="#join">{p.cta}</a>
    </div>
  </section>

  <section class="wrap section" id="overview">
    <p class="kicker">Who it's for</p>
    <h2>{p.forHead}</h2>
    <p class="lead">{p.intro}</p>
    <div class="grid">
      {p.forWho.map((f: any) => (
        <div class="card"><h3>{f.t}</h3><p class="muted">{f.d}</p></div>
      ))}
    </div>
  </section>

  {isRec && (
    <section class="wrap section" id="formats">
      <p class="kicker">How we play</p>
      <h2>Small-sided games. Tons of touches.</h2>
      <p class="lead">{FORMAT_INSPIRATION}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Division</th><th>Format</th><th>Field (yds)</th><th>Goals (ft)</th><th>Ball</th><th>Roster</th><th>Referees</th></tr>
          </thead>
          <tbody>
            {REC_DIVISIONS.map((d) => (
              <tr>
                <td><strong>{d.division}</strong></td>
                <td>{d.format}{d.keepers ? ' + keeper' : ', no keepers'}</td>
                <td>{d.field}</td>
                <td>{d.goals}</td>
                <td>Size {d.ball}</td>
                <td>{d.roster}</td>
                <td>{d.referees}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="rules">
        {REC_GAME_RULES.map((r) => <li>{r}</li>)}
      </ul>
    </section>
  )}

  <section class="wrap section" id="leagues">
    <p class="kicker">Leagues</p>
    <h2>Where we compete</h2>
    <div class="grid">
      {p.leagues.map((l: any) => (
        <div class="card">
          {l.logo && <Image src={img(l.logo)} alt={l.name} height={56} class="badge" />}
          <span class="kicker">{l.level}</span>
          <h3>{l.name}</h3>
          <p class="muted">{l.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section" id="season">
    <p class="kicker">Season</p>
    <h2>The year at a glance</h2>
    <div class="months">{MONTHS.map((m: string) => <span>{m}</span>)}</div>
    <div class="phases">
      {p.phases.map((ph: any) => (
        <div class="phase" style={`grid-column: ${ph.a + 1} / ${ph.b + 1}`}>
          <strong>{ph.label}</strong>
          <span class="muted">{ph.d}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section" id="schedule">
    <p class="kicker">Schedule</p>
    <h2>A typical week</h2>
    <div class="week">
      {p.week.map((d: any) => (
        <div class={`day ${d.items.length ? 'on' : ''}`}>
          <span class="muted">{d.day}</span>
          {d.items.map((it: any) => (
            <div class={`slot ${it.k}`}><strong>{it.t}</strong><span>{it.label}</span></div>
          ))}
        </div>
      ))}
    </div>
    <p class="muted note">{p.commitNote}</p>
  </section>

  <section class="wrap section" id="cost">
    <p class="kicker">Cost</p>
    <div class="cost card">
      <div>
        <div class="price">{money(p.cost)} <span class="muted">{p.unit}</span></div>
        <p class="muted">or {p.installLabel} of {money(p.cost / p.installs)}</p>
        <p class="muted">{p.costNote}</p>
      </div>
      <ul>{p.includes.map((i: string) => <li>{i}</li>)}</ul>
    </div>
  </section>

  <section class="wrap section" id="staff">
    <p class="kicker">Staff</p>
    <h2>Who runs it</h2>
    <div class="grid">
      {p.directors.map((d: any) => (
        <div class="card"><span class="kicker">{d.role}</span><h3>{d.name}</h3><p class="muted">{d.bio}</p></div>
      ))}
      {p.coaches.map((c: any) => (
        <div class="card"><span class="kicker">{c.role}</span><h3>{c.name}</h3></div>
      ))}
    </div>
  </section>

  <section class="wrap section" id="join">
    <p class="kicker">{p.tabLabel}</p>
    <h2>{p.joinHead}</h2>
    <p class="lead">{p.joinCopy}</p>
    <p class="muted small">{p.sessionLabel}</p>
    <div class="grid">
      {p.sessions.map((s: any) => (
        <div class="card"><h3>{s.date}</h3><p>{s.time}</p><p class="muted">{s.ages} · {s.loc}</p></div>
      ))}
    </div>
    {isRec && <p class="muted policy">{COMBINING_POLICY}</p>}
    <a class="btn btn-solid" href={p.registerUrl ?? '#'}>{p.cta}</a>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; min-height: 60vh; display: flex; align-items: flex-end; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.2) brightness(.8); }
  .hero-tint { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(17,19,24,.3) 0%, rgba(17,19,24,.6) 50%, #111318 100%); }
  .hero-inner { position: relative; padding-top: 120px; padding-bottom: 56px; width: 100%; }
  .name { font-size: clamp(64px, 12vw, 180px); line-height: .9; letter-spacing: -.05em; }
  .lead { max-width: 560px; font-size: 17px; color: var(--color-neutral-300); margin-bottom: 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; margin: 24px 0; }
  .card h3 { margin-top: 6px; }
  .badge { height: 56px; width: auto; margin-bottom: 12px; }
  .rules { margin: 24px 0 0; padding-left: 20px; color: var(--color-neutral-300); }
  .rules li { margin-bottom: 6px; }
  .months, .phases { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; }
  .months span { font-size: 12px; color: var(--color-neutral-500); padding: 6px 0; }
  .phase { background: var(--color-surface); border-top: 2px solid var(--color-accent); border-radius: var(--radius-sm); padding: 10px; display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
  .week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; margin-top: 24px; }
  .day { background: var(--color-surface); border-radius: var(--radius-md); padding: 10px; min-height: 96px; font-size: 13px; opacity: .55; }
  .day.on { opacity: 1; border: 1px solid var(--color-divider); }
  .slot { margin-top: 8px; display: flex; flex-direction: column; border-left: 2px solid var(--color-accent); padding-left: 8px; }
  .slot.m { border-color: var(--color-accent-300); }
  .note { margin-top: 16px; }
  .cost { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px; margin-top: 16px; }
  .price { font-size: 44px; font-weight: 500; letter-spacing: -.02em; }
  .price span { font-size: 15px; font-weight: 400; }
  .cost ul { margin: 0; padding-left: 20px; }
  .small { font-size: 13px; }
  .policy { max-width: 640px; font-size: 13px; }
  @media (max-width: 720px) {
    .months { display: none; }
    .phases { grid-template-columns: 1fr; }
    .phase { grid-column: auto !important; }
    .week { grid-template-columns: 1fr; }
    .day { min-height: 0; }
    .day:not(.on) { display: none; }
  }
</style>
