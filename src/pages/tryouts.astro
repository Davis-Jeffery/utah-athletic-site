---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SiteHeader from '../components/SiteHeader.jsx';
import SiteFooter from '../components/SiteFooter.jsx';
import TryoutsApp from '../components/TryoutsApp.jsx';
import { loadSite } from '../lib/content';
import { buildAssets } from '../lib/assets';

const data = await loadSite();
const pg = data.pages.tryouts;
const A = await buildAssets();
// Only what the filters need, so the page stays light.
const tryData = {
  programs: data.programs.map(({ id, name, ages, ageGroups, kind, invite, registerUrl, regions }) => ({ id, name, ages, ageGroups, kind, invite, registerUrl, regions })),
  regions: data.regions, tryouts: data.tryouts, sessions: data.sessions, builtOn: data.builtOn,
  bring: data.settings.tryoutBring, hide: pg.hide, order: pg.order,
  mainEmail: data.settings.mainEmail,
};
---
<Base title={data.seo.tryouts.title} description={data.seo.tryouts.description} image={data.seo.tryouts.image} preload={A['collage-c14@lg']}>
  <div style="position:relative;min-height:100vh;overflow-x:clip;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body)">
    <SiteHeader current="tryouts" logo={data.logo} tryoutsLabel={data.settings.tryoutsLabel} sticky={false} />
    <PageHero kicker={data.settings.tryoutsLabel} photo={A['collage-c14@lg']}>
      <h1 style="margin:0;font:500 clamp(46px,7vw,104px)/.92 var(--font-heading);letter-spacing:-.05em;text-wrap:balance">{pg.heading}{pg.headingAccent ? <> <span style="color:#78b7b3">{pg.headingAccent}</span></> : null}</h1>
      <p style="margin:0;max-width:560px;font-size:clamp(15px,1.4vw,18px);line-height:1.6;color:var(--color-neutral-300);text-wrap:pretty">{pg.intro}</p>
    </PageHero>
    <TryoutsApp client:load data={tryData} />
    <SiteFooter note="Registration is handled in Ollie." />
  </div>
</Base>
